# Copy this file to .env and fill in your values
# NEVER commit .env to git
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.

# ── API ───────────────────────────────────────────────────────────────────────
# Full base URL of the Express backend API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# ── Demo login hints ──────────────────────────────────────────────────────────
# Set to "true" to show demo account credentials on the login page.
# Set to "false" (or remove) for any public/production deployment.
VITE_SHOW_DEMO_LOGINS=true

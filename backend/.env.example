# Copy this file to .env and fill in your values
# NEVER commit .env to git

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/performiq?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# CORS — allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# ML Service URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Demo seed credentials & PRNG seed (demo only — change before public deployment)
SEED_RANDOM_SEED=42
DEMO_ADMIN_PASSWORD=AdminDemo123!
DEMO_TEACHER_PASSWORD=TeacherDemo123!

# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in live deployments. The server enforces strong secrets
# when this is "production" and refuses to start if defaults are detected.
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas connection string for the application database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/performiq?retryWrites=true&w=majority

# Separate database used only by the automated test suite (never touches production data)
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/performiq_test?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be changed before any public deployment.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your exact frontend domain (e.g. https://performiq.example.com)
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max login attempts per 15 minutes per IP. Default: 10 (production-safe).
# You may raise this during local development.
AUTH_RATE_LIMIT=10

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Demo seed credentials (demo only — CHANGE before public deployment) ───────
SEED_RANDOM_SEED=42
DEMO_ADMIN_PASSWORD=AdminDemo123!
DEMO_TEACHER_PASSWORD=TeacherDemo123!
